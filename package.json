{
  "name": "agent-skills",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "bunx biome check --write lib evals/lib scripts",
    "lint": "bunx biome check --error-on-warnings lib evals/lib scripts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test lib evals/lib scripts",
    "prepare": "! git rev-parse --git-dir >/dev/null 2>&1 || git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
